# config.local — machine-specific ssh hosts, NOT committed. [D-SECRETS-LOCAL]
# Copy to ~/.ssh/config.local and add your hosts. These are read before the
# generic `Host *` block in ~/.ssh/config, so they take precedence.
#
# Host myserver
#   Hostname server.example.com
#   User me
#   Port 22
#
# Host home
#   Hostname my-home-box
#   User me
#   Port 55239
