# ~/.ssh/config — common ssh config (repo-owned). [D-CARRY-SET]
# Machine-specific Host entries live in ~/.ssh/config.local (gitignored).
# [D-SECRETS-LOCAL]
#
# Include is first so per-host settings in config.local take precedence — ssh
# uses the FIRST value seen for each keyword. A missing include file is ignored.
Include config.local

Host *
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519
