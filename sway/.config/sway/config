# sway config — see `man 5 sway` for reference
# Only customizations listed. Sway defaults handle: hjkl/arrow focus+move,
# workspace 1-10, resize mode, kill, reload, exit, layout, scratchpad.

set $mod Mod1

font pango:monospace 8

# ─── Session ─────────────────────────────────────────────────────────────────

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec dex --autostart --environment sway
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 000000'
exec nm-applet --indicator
exec mako

# ─── Input ───────────────────────────────────────────────────────────────────

input type:keyboard {
    repeat_delay 300
    repeat_rate 35
    xkb_options ctrl:nocaps
}

input type:pointer {
    accel_profile flat
    pointer_accel 0.6
}

# ─── Output ──────────────────────────────────────────────────────────────────

output * bg ~/.local/share/backgrounds/2024-01-17-18-06-42-spiral.png fill #000000

# ─── Core overrides ──────────────────────────────────────────────────────────

bindsym $mod+Return exec sh -c 'if command -v ghostty >/dev/null 2>&1; then exec ghostty; else exec foot; fi'
bindsym $mod+d exec rofi -show drun -show-icons
bindsym $mod+z splith

# ─── Appearance ──────────────────────────────────────────────────────────────

default_border pixel 2
client.focused #77dd77 #285577 #ffffff #2e9ef4 #285577

# ─── Bar ─────────────────────────────────────────────────────────────────────

bar {
    status_command i3status
}

# ─── Workspace assignments ───────────────────────────────────────────────────

for_window [app_id="com.mitchellh.ghostty"] move workspace 1

# ─── Custom keybindings ──────────────────────────────────────────────────────

bindsym $mod+Shift+x exec swaylock -f -c 000000
bindsym $mod+Ctrl+greater move workspace to output next

# Volume
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +10% && notify-send "brightness up"
bindsym XF86MonBrightnessDown exec brightnessctl set 10%- && notify-send "brightness down"

# Screenshots
bindsym Print exec sh -c 'f="$HOME/Downloads/Screenshot_$(date +%Y-%m-%d-%I.%M.%S_%p).png" && grim "$f" && wl-copy < "$f"'
bindsym Shift+Print exec sh -c 'f="$HOME/Downloads/Screenshot_$(date +%Y-%m-%d-%I.%M.%S_%p).png" && grim -g "$(slurp)" "$f" && wl-copy < "$f"'

# ─── Machine-local overrides ────────────────────────────────────────────────
include ~/.config/sway/config.local
