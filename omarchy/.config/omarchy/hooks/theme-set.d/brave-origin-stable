#!/usr/bin/env bash
# Refresh stable Brave Origin after Omarchy theme changes until upstream's browser
# theming helper targets brave-origin instead of beta. [D-BROWSER-DEFAULT][F-APP-CHANNELS]

set -euo pipefail

# Exact process-name matching avoids matching this hook's brave-origin-stable path.
if command -v omarchy-cmd-present >/dev/null 2>&1 &&
  omarchy-cmd-present brave-origin &&
  pgrep -x brave-origin >/dev/null 2>&1; then
  brave-origin --refresh-platform-policy --no-startup-window >/dev/null 2>&1 || true
fi
