#!/usr/bin/env bash
# Minimal Omarchy overlay installer; docs/index.html carries the design context. [D-SCRIPTS-MINIMAL]
# Keep runtime behavior idempotent and limited to repo-owned seams. [D-IDEMPOTENT]

set -euo pipefail

# ── bootstrap ────────────────────────────────────────────────────────────────
REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$REPO"

# Shared palette + managed-block marker contract; single source of truth in lib/style.sh.
# shellcheck source=lib/style.sh
. "$REPO/lib/style.sh"
step() { printf '\n%s── %s ──%s\n' "$BOLD" "$*" "$NC"; }
info() { printf '%sℹ%s %s\n' "$CYAN" "$NC" "$*"; }
success() { printf '%s✔%s %s\n' "$GREEN" "$NC" "$*"; }
warn() { printf '%s⚠%s %s\n' "$YELLOW" "$NC" "$*"; }
die() {
  printf '%s✖%s %s\n' "$RED" "$NC" "$*" >&2
  exit 1
}

# ── helpers ──────────────────────────────────────────────────────────────────
# Re-anchor managed blocks at EOF because load order decides precedence.
# Body comes from stdin. [D-DELTA-STORAGE][D-IDEMPOTENT]
upsert_block() {
  local file="$1" name="$2" copen="$3" cclose="${4:-}" begin end body
  begin="$(managed_marker begin "$name" "$copen" "$cclose")"
  end="$(managed_marker end "$name" "$copen" "$cclose")"
  body="$(cat)"
  if [ ! -f "$file" ]; then
    warn "skip managed block — missing $file"
    return 0
  fi
  # Unbalanced markers could make awk eat user content, so refuse to edit.
  # Whole-line marker matching prevents accidental substring-triggered deletion.
  if grep -qxF -- "$begin" "$file"; then
    grep -qxF -- "$end" "$file" || die "begin marker without end marker in $file — refusing to edit"
    local _nb
    _nb=$(grep -cxF -- "$begin" "$file")
    [ "$_nb" -gt 1 ] && die "duplicate begin marker ($_nb) in $file — refusing to edit"
  fi
  # Trim trailing blanks for byte-stable re-runs; abort before appending if awk
  # fails because it is non-final in the redirection pipeline. [D-IDEMPOTENT]
  if ! awk -v b="$begin" -v e="$end" '
    $0==b{s=1}
    !s{ buf[++n]=$0 }
    s&&$0==e{s=0}
    END{ while (n>0 && buf[n] ~ /^[[:space:]]*$/) n--; for(i=1;i<=n;i++) print buf[i] }
  ' "$file" >"$file.dotfiles.tmp"; then
    rm -f "$file.dotfiles.tmp"
    die "failed to rewrite $file (awk error) — left it untouched"
  fi
  mv "$file.dotfiles.tmp" "$file"
  printf '\n%s\n%s\n%s\n' "$begin" "$body" "$end" >>"$file"
  info "managed block updated in ${file/#$HOME/\~}"
}

# Remove an obsolete managed block without touching the surrounding mutable
# file. This is the one-way v3 Hyprland source-to-Lua migration. [D-IDEMPOTENT]
remove_block() {
  local file="$1" name="$2" copen="$3" cclose="${4:-}" begin end begins ends begin_line end_line
  [ -f "$file" ] || return 0
  begin="$(managed_marker begin "$name" "$copen" "$cclose")"
  end="$(managed_marker end "$name" "$copen" "$cclose")"
  begins=$(grep -cxF -- "$begin" "$file" || true)
  ends=$(grep -cxF -- "$end" "$file" || true)
  [ "$begins" -eq 0 ] && [ "$ends" -eq 0 ] && return 0
  [ "$begins" -eq 1 ] && [ "$ends" -eq 1 ] ||
    die "unbalanced or duplicate managed block in $file — refusing to edit"
  begin_line=$(grep -nF -- "$begin" "$file" | cut -d: -f1)
  end_line=$(grep -nF -- "$end" "$file" | cut -d: -f1)
  [ "$begin_line" -lt "$end_line" ] ||
    die "managed block markers are reversed in $file — refusing to edit"
  if ! awk -v b="$begin" -v e="$end" '
    $0==b{s=1; next}
    s&&$0==e{s=0; next}
    !s{print}
  ' "$file" >"$file.dotfiles.tmp"; then
    rm -f "$file.dotfiles.tmp"
    die "failed to remove managed block from $file — left it untouched"
  fi
  mv "$file.dotfiles.tmp" "$file"
  info "obsolete managed block removed from ${file/#$HOME/\~}"
}

# shell.toml is user-owned but atomically rewritten by Quickshell settings.
# Merge one scalar without replacing unrelated runtime-owned keys.
# [D-QUICKSHELL-DELTAS][D-IDEMPOTENT]
upsert_toml_key() {
  local file="$1" section="$2" key="$3" value="$4" tmp
  mkdir -p "$(dirname "$file")"
  [ -f "$file" ] || install -m 600 /dev/null "$file"
  tmp="$(mktemp "${file}.dotfiles.XXXXXX")"
  if ! awk -v section="$section" -v key="$key" -v value="$value" '
    function header_name(line, name) {
      name = line
      sub(/^[[:space:]]*\[/, "", name)
      sub(/\][[:space:]]*$/, "", name)
      return name
    }
    /^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
      if (in_section && !wrote) { print key " = " value; wrote = 1 }
      in_section = (header_name($0) == section)
      if (in_section) section_seen = 1
    }
    in_section && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      if (!wrote) { print key " = " value; wrote = 1 }
      next
    }
    { print }
    END {
      if (in_section && !wrote) print key " = " value
      if (!section_seen) {
        if (NR > 0) print ""
        print "[" section "]"
        print key " = " value
      }
    }
  ' "$file" >"$tmp"; then
    rm -f "$tmp"
    die "failed to merge $section.$key into $file"
  fi
  if cmp -s "$tmp" "$file"; then
    rm -f "$tmp"
    return 1
  fi
  cp -f "$tmp" "$file"
  rm -f "$tmp"
  info "TOML delta applied to ${file/#$HOME/\~} ($section.$key)"
  return 0
}

# Idempotent jq overlay for tool-owned JSON; returns 0 only on content change.
# cp -f preserves the target mode while keeping mutable state out of Stow.
# [D-IDEMPOTENT][D-DELTA-STORAGE]
apply_jq_deltas() {
  local target="$1" filter="$2" label="${3:-jq deltas}" new tmp target_clean
  if [ ! -f "$target" ]; then
    warn "skip $label — missing $target"
    return 1
  fi
  # Surface jq's actual diagnostic (parse error, type error, bad path) instead
  # of swallowing it; debugging a failed filter requires that context.
  if ! new=$(jq -f "$filter" "$target"); then
    die "$label: jq filter failed on $filter against $target (see error above)"
  fi
  # Both $() captures strip trailing newlines, so comparing them is tolerant
  # of whether the source file ends with 0, 1, or more terminal newlines.
  target_clean=$(<"$target")
  if [ "$new" = "$target_clean" ]; then
    return 1
  fi
  tmp="$target.dotfiles.tmp"
  if ! printf '%s\n' "$new" >"$tmp"; then
    rm -f "$tmp"
    die "$label: failed to stage $tmp (disk full? permission denied?)"
  fi
  if ! cp -f "$tmp" "$target"; then
    rm -f "$tmp"
    die "$label: failed to install $target from $tmp"
  fi
  rm -f "$tmp"
  info "$label applied to ${target/#$HOME/\~}"
  return 0
}

# Back up foreign files/symlinks once so stow can manage the path safely.
# Targets already symlinked into the repo are left alone (stow -R is a no-op).
prestow_backup() {
  local t dest bak
  for t in "$@"; do
    [ -e "$t" ] || [ -L "$t" ] || continue
    if [ -L "$t" ]; then
      dest="$(readlink -f "$t" 2>/dev/null || true)"
      case "$dest" in "$REPO"/*) continue ;; esac
    fi
    bak="$t.pre-stow.$(date +%Y%m%d%H%M%S)"
    warn "backing up existing ${t/#$HOME/\~} -> ${bak/#$HOME/\~}"
    mv "$t" "$bak"
  done
}

# Print the given package names that are (or are not) installed, one per line,
# so every add/drop path shares one definition of "pacman already has it".
# $1 = installed|missing, rest = package names. [D-PKG-REMOVE][D-IDEMPOTENT]
pkg_filter() {
  local mode="$1" pkg
  shift
  for pkg in "$@"; do
    if pacman -Qq "$pkg" >/dev/null 2>&1; then
      [ "$mode" = installed ] && printf '%s\n' "$pkg"
    else
      [ "$mode" = missing ] && printf '%s\n' "$pkg"
    fi
  done
  # The loop's last test decides $? otherwise, which set -e would treat as fatal.
  return 0
}

# Retired Stow packages are no longer in STOW_PKGS, so clean up only their
# exact symlinks when they still resolve into this checkout. [D-IDEMPOTENT]
remove_legacy_repo_link() {
  local link="$1" target resolved
  [ -L "$link" ] || return 0
  target="$(readlink "$link")"
  resolved="$(realpath -m -- "$(dirname "$link")/$target")"
  case "$resolved" in
    "$REPO"/*)
      unlink "$link"
      info "retired repo link removed: ${link/#$HOME/\~}"
      ;;
  esac
}

# ── prerequisites ────────────────────────────────────────────────────────────
# Omarchy CLI is preferred over re-implementing package logic [F-CLI][D-ENGINE].
step "Prerequisites"
have omarchy-shell-config || die "Omarchy Quattro is required — upgrade the OS before running this branch"
if have stow; then
  success "stow present"
else
  have omarchy || die "Omarchy CLI not found — this repo targets Omarchy. Install stow manually: sudo pacman -S stow"
  info "installing stow via omarchy"
  omarchy pkg add stow
fi

# jq is required by apply_jq_deltas. Ships in omarchy-base, but reconcile in
# case it was pruned (Remove Preinstalled) or never installed.
if have jq; then
  success "jq present"
else
  have omarchy || die "jq required by apply_jq_deltas but Omarchy CLI not found. Install jq manually: sudo pacman -S jq"
  info "installing jq via omarchy"
  omarchy pkg add jq
fi

if [ -f packages.txt ]; then
  mapfile -t PKGS < <(parse_list_file packages.txt)
  mapfile -t MISSING_PKGS < <(pkg_filter missing "${PKGS[@]}")
  if [ "${#MISSING_PKGS[@]}" -gt 0 ]; then
    info "installing extras: ${MISSING_PKGS[*]}"
    omarchy pkg add "${MISSING_PKGS[@]}"
  fi
fi

if [ -f packages.aur.txt ]; then
  mapfile -t AUR_PKGS < <(parse_list_file packages.aur.txt)
  mapfile -t MISSING_AUR_PKGS < <(pkg_filter missing "${AUR_PKGS[@]}")
  if [ "${#MISSING_AUR_PKGS[@]}" -gt 0 ]; then
    info "installing AUR extras: ${MISSING_AUR_PKGS[*]}"
    omarchy pkg aur add "${MISSING_AUR_PKGS[@]}"
  fi
fi

# Quattro natively owns Brave Origin setup, extensions, policies, and theme
# refresh. The default command can fail only in its notification tail, so verify
# state before any browser package removal. [D-BROWSER-DEFAULT][F-APP-CHANNELS]
step "Browser and terminal defaults"
BRAVE_ORIGIN_DESKTOP="brave-origin.desktop"
if ! pacman -Qq brave-origin-bin >/dev/null 2>&1; then
  omarchy install browser brave-origin
fi
if [ "$(omarchy default browser 2>/dev/null)" != "brave-origin" ]; then
  omarchy default browser brave-origin || true
fi
[ "$(omarchy default browser)" = "brave-origin" ] ||
  die "Brave Origin did not become the default — not removing Chromium"

# xdg-settings does not assert these additional associations on every desktop.
for mime_type in "${BRAVE_MIME_TYPES[@]}"; do
  xdg-mime default "$BRAVE_ORIGIN_DESKTOP" "$mime_type"
done
success "Brave Origin is the default browser"

# Installing a supported terminal writes xdg-terminals.list. When Ghostty is
# already installed but not selected, use the official default flow instead.
# Both commands can fail in their notification tail, so assert final state.
# [D-TERM-GHOSTTY]
if ! pacman -Qq ghostty >/dev/null 2>&1; then
  omarchy install terminal ghostty || true
fi
if [ "$(omarchy default terminal 2>/dev/null)" != "ghostty" ]; then
  omarchy default terminal ghostty || true
fi
[ "$(omarchy default terminal)" = "ghostty" ] ||
  die "Ghostty did not become the default — not removing Alacritty"
success "Ghostty is the default terminal"
unset BRAVE_ORIGIN_DESKTOP mime_type

if [ -f packages.remove.txt ]; then
  mapfile -t REMOVE_PKGS < <(parse_list_file packages.remove.txt)
  mapfile -t INSTALLED_REMOVE_PKGS < <(pkg_filter installed "${REMOVE_PKGS[@]}")
  if [ "${#INSTALLED_REMOVE_PKGS[@]}" -gt 0 ]; then
    info "removing unwanted packages: ${INSTALLED_REMOVE_PKGS[*]}"
    # pacman -Rns refuses reverse-dep conflicts; warn instead of abort. [D-PKG-REMOVE]
    if ! omarchy pkg drop "${INSTALLED_REMOVE_PKGS[@]}"; then
      warn "  one or more removes refused (reverse-dep conflict?); continuing"
    fi
  fi
fi

# Quattro's upgrade normally retires these pacman packages before installing
# its mise wrappers. Reconcile interrupted/manual upgrades without touching the
# wrappers or their user config.
mapfile -t LEGACY_AGENT_PKGS < <(pkg_filter installed opencode claude-code)
if [ "${#LEGACY_AGENT_PKGS[@]}" -gt 0 ]; then
  info "dropping retired agent packages: ${LEGACY_AGENT_PKGS[*]}"
  omarchy pkg drop "${LEGACY_AGENT_PKGS[@]}"
fi
unset LEGACY_AGENT_PKGS

# Restore a missing retained Discord launcher through Quattro's application
# lifecycle; the refresh may also recopy denied launchers, removed just below.
# [D-WEBAPP][F-APP-CHANNELS]
DISCORD_WEBAPP="$HOME/.local/share/applications/Discord.desktop"
if [ ! -f "$DISCORD_WEBAPP" ]; then
  info "restoring Quattro's Discord web app"
  omarchy refresh applications
fi
unset DISCORD_WEBAPP

# Quattro refreshes packaged launchers into the user application directory.
# Reapply only the explicit stock-webapp deltas through its supported remover;
# retained Discord/Zoom and user-installed Tailscale are absent. [D-WEBAPP]
if [ -f webapps.remove.txt ]; then
  mapfile -t REMOVE_WEBAPPS < <(parse_list_file webapps.remove.txt)
  for webapp in "${REMOVE_WEBAPPS[@]}"; do
    if [ -f "$HOME/.local/share/applications/$webapp.desktop" ]; then
      info "removing unwanted web app: $webapp"
      OMARCHY_REMOVE_NOTIFY=false omarchy webapp remove "$webapp"
    fi
  done
fi
unset REMOVE_WEBAPPS webapp

# Quattro owns the lazy OpenCode launcher; seed only its mutable user config,
# then assert the personal LSP delta. [D-OPENCODE-LSP][F-OPENCODE-LSP]
OPENCODE_CONFIG="$HOME/.config/opencode/opencode.json"
if [ ! -f "$OPENCODE_CONFIG" ]; then
  info "seeding OpenCode config from Omarchy default"
  omarchy refresh config opencode/opencode.json
fi
apply_jq_deltas "$OPENCODE_CONFIG" "$REPO/opencode/settings.jq" "OpenCode settings" || true
unset OPENCODE_CONFIG

# Prefer Omarchy's dev-env channel for uv/go so PATH ownership stays consistent.
# [D-DEV-ENV][F-CLI][D-IDEMPOTENT]
ensure_dev_env_tool() {
  local tool="$1" kind="$2"
  if pacman -Qq "$tool" >/dev/null 2>&1; then
    info "dropping pacman copy of $tool (omarchy dev-env is canonical for this tool)"
    # Package removal can fail on reverse dependencies; keep reconciliation
    # best-effort rather than aborting unrelated installer work.
    if ! omarchy pkg drop "$tool"; then
      warn "  could not drop pacman $tool (likely a reverse dependency); leaving it in place"
    fi
  fi
  if ! have "$tool"; then
    info "installing $tool via 'omarchy install dev-env $kind'"
    omarchy install dev-env "$kind"
  fi
}

ensure_dev_env_tool uv python
ensure_dev_env_tool go go

# ── XDG user dirs ────────────────────────────────────────────────────────────
# Collapse unused Documents/Music and add XDG_PROJECTS_DIR for local scripts. [F-CLI]
step "XDG user dirs"
# Bootstrap missing xdg-user-dirs so stripped installs still reach stow/blocks.
if ! have xdg-user-dirs-update; then
  info "installing xdg-user-dirs via omarchy"
  omarchy pkg add xdg-user-dirs
fi
mkdir -p "$HOME/Projects"
xdg-user-dirs-update --set DOCUMENTS "$HOME"
xdg-user-dirs-update --set MUSIC "$HOME"
xdg_dirs="$HOME/.config/user-dirs.dirs"
# user-dirs.dirs stores literal $HOME values, matching xdg-user-dirs-update.
# shellcheck disable=SC2016
projects_line='XDG_PROJECTS_DIR="$HOME/Projects"'
if [ -f "$xdg_dirs" ]; then
  if ! grep -qxF -- "$projects_line" "$xdg_dirs"; then
    sed -i '/^XDG_PROJECTS_DIR=/d' "$xdg_dirs"
    printf '%s\n' "$projects_line" >>"$xdg_dirs"
  fi
  success "XDG dirs reconciled (Documents/Music -> \$HOME; Projects=\~/Projects)"
else
  # A tool no-op here would leave only XDG_PROJECTS_DIR in a new stub, hiding the
  # missing spec keys; surface the drift instead.
  warn "skipped XDG reconcile — $xdg_dirs not present (xdg-user-dirs-update silently no-op'd; check /etc/xdg/user-dirs.conf)"
fi

# ── stow repo-owned files ────────────────────────────────────────────────────
# Stow only repo-owned namespaces; Omarchy-owned files get managed blocks. [D-DELTA-STORAGE]
step "Stow"
# The v3 seam sources files this branch retires. Remove it before cleaning its
# links so hyprland.conf cannot retain a dangling source directive.
remove_block "$HOME/.config/hypr/hyprland.conf" hypr '#'
remove_legacy_repo_link "$HOME/.config/dotfiles/hypr.conf"
remove_legacy_repo_link "$HOME/.config/dotfiles/hypr.local.conf.example"
remove_legacy_repo_link "$HOME/.config/elephant/websearch.toml"
remove_legacy_repo_link "$HOME/.config/omarchy/hooks/theme-set.d/brave-origin-stable"
remove_legacy_repo_link "$HOME/.config/omarchy/shell.toml"
# Retired custom RAM widget; Quattro's power panel reports memory natively via
# omarchy-system-stats. shell.jq drops the bar module, this drops its script.
remove_legacy_repo_link "$HOME/.config/omarchy/bar/scripts/memory-status"
prestow_backup "$HOME/.ssh/config"
# UWSM env.d is stowed because Omarchy-launched apps inherit that session env. [F-SSH-AGENT]
prestow_backup "$HOME/.config/uwsm/env.d/dotfiles.sh"
# Claude Code statusline is a pure user script (Claude never rewrites it), so it
# stows; settings.json is tool-rewritten and rides a jq delta instead. [D-CLAUDE-CONFIG]
prestow_backup "$HOME/.claude/statusline-command.sh"
prestow_backup "$HOME/.config/hypr/dotfiles.lua"
prestow_backup \
  "$HOME/.config/omarchy/plugins/pashbyl.workspaces/manifest.json" \
  "$HOME/.config/omarchy/plugins/pashbyl.workspaces/Workspaces.qml"
STOW_PKGS=(bash ssh bin hypr tmux nvim uwsm omarchy claude)
stow -R -t "$HOME" --no-folding "${STOW_PKGS[@]}"
success "stowed: ${STOW_PKGS[*]}"

# Quickshell preserves user overrides but rewrites this file when settings such
# as font size change. Keep it mutable and reassert only the exact urgent role.
upsert_toml_key "$HOME/.config/omarchy/shell.toml" bar active '"#a55555"' || true

# Stale user launchers survive package removal because pacman never owned them.
# [D-PKG-REMOVE][D-TERM-GHOSTTY]
rm -f "$HOME/.local/share/applications/typora.desktop"
# Omarchy migration 1763558828 created this user-owned override while Alacritty
# was installed; pacman cannot remove it with the package. Keep the package
# guard — the launcher is legitimate while Alacritty is still installed.
if ! pacman -Qq alacritty >/dev/null 2>&1; then
  rm -f "$HOME/.local/share/applications/Alacritty.desktop"
fi
# omarchy-refresh-applications copies Foot's packaged launcher even when the
# package is denied. Remove every user-level variant after the package drop.
if ! pacman -Qq foot >/dev/null 2>&1; then
  rm -f \
    "$HOME/.local/share/applications/foot.desktop" \
    "$HOME/.local/share/applications/foot-server.desktop" \
    "$HOME/.local/share/applications/footclient.desktop"
fi

# ssh ignores overly-open config paths; harden the dir + every config file.
[ -d "$HOME/.ssh" ] && chmod 700 "$HOME/.ssh" 2>/dev/null || true
for f in config config.local; do
  [ -e "$HOME/.ssh/$f" ] && chmod 600 "$HOME/.ssh/$f" 2>/dev/null || true
done

# ── integration blocks ───────────────────────────────────────────────────────
step "Integration"

# Source shell additions last so personal aliases win. [D-SHELL-SEAM][F-BASH-CHAIN]
upsert_block "$HOME/.bashrc" shell '#' <<'EOF'
# [D-SHELL-SEAM] personal shell additions — see docs/decisions.html#D-SHELL-SEAM
[ -f ~/.config/dotfiles/shell.sh ] && . ~/.config/dotfiles/shell.sh
[ -f ~/.config/dotfiles/shell.local.sh ] && . ~/.config/dotfiles/shell.local.sh
EOF

# Load a reloadable personal module after Quattro defaults. hyprland.lua is
# Omarchy-owned and refreshable, so reassert this seam on every run.
# [D-CAPS-CTRL][F-HYPR-SEAM]
upsert_block "$HOME/.config/hypr/hyprland.lua" hypr '--' <<'EOF'
-- [D-DELTA-STORAGE] reload-safe personal Hyprland overlay
local require_optional = require("default.hypr.require_optional")
require("hypr.dotfiles")
require_optional.module("hypr.dotfiles_local")
EOF

# Load our tracked nvim fragment via Omarchy's keymaps.lua, not the cp-reset tree. [D-NVIM-KEYMAPS][F-NVIM-OWNED]
upsert_block "$HOME/.config/nvim/lua/config/keymaps.lua" keymaps '--' <<'EOF'
-- [D-NVIM-KEYMAPS] load the tracked fragment — see docs/decisions.html#D-NVIM-KEYMAPS
-- Skip silently if absent (e.g. pre-stow); surface real load/exec errors instead
-- of swallowing them, so a typo in the fragment doesn't degrade nvim in silence.
local f = vim.fn.expand("~/.config/dotfiles/nvim.lua")
local ok, err = pcall(dofile, f)
if not ok and vim.fn.filereadable(f) == 1 then
  vim.notify("dotfiles nvim.lua: " .. err, vim.log.levels.ERROR)
end
EOF

# Source via Omarchy's preferred XDG tmux config so our deltas win. [D-TMUX-KEEP][F-TMUX-XDG]
upsert_block "$HOME/.config/tmux/tmux.conf" tmux '#' <<'EOF'
# [D-TMUX-KEEP] personal tmux overlay — see docs/decisions.html#D-TMUX-KEEP
source-file ~/.config/tmux/local.conf
EOF

# Show the active venv's name in the prompt via a $VIRTUAL_ENV-keyed custom
# module. starship.toml is seed-once + never auto-refreshed, so editing in place
# is safe; the format scalar can't take a merged delta, so reference the module
# there with sed, then define the module table via a managed block. Full
# rationale: docs/decisions.html#D-STARSHIP-VENV. [D-STARSHIP-VENV]
STARSHIP_TOML="$HOME/.config/starship.toml"
if [ ! -f "$STARSHIP_TOML" ]; then
  warn "skip starship venv delta — missing ${STARSHIP_TOML/#$HOME/\~}"
else
  # ${custom.venv} / $character are literal starship tokens for grep + sed, not
  # shell expansions; silence SC2016 across the in-place edits below.
  # shellcheck disable=SC2016
  # One-way migration: the module used to be spliced into Omarchy's `format`
  # scalar. right_format is additive, so drop the old inline reference or the
  # venv renders twice. [D-STARSHIP-VENV]
  if grep -qF '${custom.venv}$character' "$STARSHIP_TOML"; then
    sed -i 's/${custom\.venv}\$character/$character/' "$STARSHIP_TOML"
    info "starship: removed the legacy inline \${custom.venv} reference"
  fi
  # right_format must be a root key, but upsert_block appends at EOF — which
  # lands inside the last table. Line 1 is unambiguously top-level, and unlike
  # the old splice this never rewrites Omarchy's own format string.
  # shellcheck disable=SC2016
  if ! grep -qF 'right_format' "$STARSHIP_TOML"; then
    sed -i '1i right_format = "${custom.venv}"' "$STARSHIP_TOML"
    info "starship: added right_format referencing \${custom.venv}"
  fi
  # Define the module: print the venv name only, nothing when $VIRTUAL_ENV unset.
  upsert_block "$STARSHIP_TOML" starship-venv '#' <<'EOF'
# [D-STARSHIP-VENV] active venv name — see docs/decisions.html#D-STARSHIP-VENV
[custom.venv]
command = 'basename "$VIRTUAL_ENV"'
when = 'test -n "$VIRTUAL_ENV"'
format = '[\($output\)]($style) '
style = 'italic yellow'
EOF
fi
unset STARSHIP_TOML

# Quattro's shell.json is mutable and canonical once customized. Source its
# official helper for stock fallback, normalization, atomic commit, and reload;
# Stow owns only the plugin and command; both shell config files stay mutable.
# [D-QUICKSHELL-DELTAS][D-IDEMPOTENT]
SHELL_CONFIG_HELPER="$(command -v omarchy-shell-config)"
# shellcheck source=/usr/bin/omarchy-shell-config disable=SC1090,SC1091
. "$SHELL_CONFIG_HELPER"
shell_source="$(source_file)"
jq -e 'type == "object"' "$shell_source" >/dev/null ||
  die "Quickshell config root is not an object — refusing to replace it"
shell_delta="$(<"$REPO/omarchy/shell.jq")"
shell_program="$NORMALIZE | $shell_delta"
shell_new="$(jq -S -e "$shell_program" "$shell_source")" ||
  die "Quickshell config delta failed"
shell_current="$(jq -S -e . "$CONFIG_FILE" 2>/dev/null || true)"

omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
if [ "$shell_new" != "$shell_current" ]; then
  commit "$shell_program"
  info "Quickshell layout delta applied to ${CONFIG_FILE/#$HOME/\~}"
else
  success "Quickshell layout already converged"
fi
unset SHELL_CONFIG_HELPER shell_source shell_delta shell_program shell_new shell_current

# The upgrade may preserve custom legacy UWSM lines in a later-sorting fragment.
# Do not delete potentially unique state automatically; surface it for the
# one-time migration audit. [F-SSH-AGENT]
if [ -f "$HOME/.config/uwsm/env.d/99-omarchy-upgrade-env" ]; then
  warn "review ~/.config/uwsm/env.d/99-omarchy-upgrade-env for duplicate or overriding exports"
fi

# Overlay our Claude Code settings idempotently. Claude rewrites settings.json
# itself (via /config), so we assert only our keys via jq — preserving any keys
# Claude adds — instead of stowing the file. Seed {} first because apply_jq_deltas
# warns + skips on a missing target (pre-first-run machine). [D-CLAUDE-CONFIG]
mkdir -p "$HOME/.claude"
[ -f "$HOME/.claude/settings.json" ] || printf '{}\n' >"$HOME/.claude/settings.json"
# settings.jq selects custom:omarchy, so the generated theme must exist first.
# omarchy-theme-set runs this on every theme change; call it here for first
# install and after a themes/ wipe. Without --activate it only writes the theme
# file, leaving .theme to our jq delta. [D-CLAUDE-CONFIG]
have omarchy-theme-set-claude && omarchy-theme-set-claude
# `|| true`: apply_jq_deltas returns 1 on "no change" under set -e; a real jq
# error still dies inside the helper.
apply_jq_deltas "$HOME/.claude/settings.json" "$REPO/claude/settings.jq" "claude settings" || true

# ── validation ───────────────────────────────────────────────────────────────
if have hyprctl && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  step "Validate Hyprland"
  if hyprctl reload >/dev/null 2>&1; then success "hyprctl reload ok"; else warn "hyprctl reload failed"; fi
  errs="$(hyprctl configerrors 2>/dev/null || true)"
  # Clean when output is empty/whitespace or contains "no error". Don't rely on
  # `grep -v` exit status over empty input (varies across grep implementations).
  if [ -z "${errs//[[:space:]]/}" ] || printf '%s' "$errs" | grep -qiF 'no error'; then
    success "no Hyprland config errors"
  else
    warn "hyprctl reported config issues:"
    printf '%s\n' "$errs"
  fi
fi

step "Done"
success "Overlay installed. Open a new shell (or 'exec bash') to load shell changes."
