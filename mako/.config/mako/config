default-timeout=5000
border-size=2
border-color=#77dd77
background-color=#333333
text-color=#ffffff

[urgency=critical]
default-timeout=0

# Toggle via `makoctl mode -t do-not-disturb`. Critical still pops so
# a dying battery isn't missed.
[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb urgency=critical]
invisible=false
