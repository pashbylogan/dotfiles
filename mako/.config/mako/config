width=360
margin=12
padding=12
border-size=1
border-radius=8
max-icon-size=48
group-by=app-name
default-timeout=5000

[urgency=critical]
default-timeout=0

# Toggle via `makoctl mode -t do-not-disturb`. Critical still pops so
# a dying battery isn't missed.
[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb urgency=critical]
invisible=false
