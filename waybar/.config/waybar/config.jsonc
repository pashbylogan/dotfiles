{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 0,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": [
    "custom/idle",
    "power-profiles-daemon",
    "pulseaudio",
    "bluetooth",
    "network",
    "cpu",
    "memory",
    "battery",
    "tray",
    "clock"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "format": "{name}"
  },
  "sway/window": {
    "max-length": 90,
    "separate-outputs": true
  },
  "custom/idle": {
    "exec": "$HOME/.local/lib/dotfiles/sway-idle-status",
    "return-type": "json",
    "restart-interval": 1
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "performance": "perf",
      "balanced": "bal",
      "power-saver": "save"
    }
  },
  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "muted"
  },
  "bluetooth": {
    "format": "bt off",
    "format-disabled": "bt off",
    "format-connected": "bt {num_connections}",
    "tooltip-format-connected": "{device_alias}"
  },
  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "{ifname}",
    "format-disconnected": "offline"
  },
  "cpu": {
    "format": "cpu {usage}%"
  },
  "memory": {
    "format": "mem {}%"
  },
  "battery": {
    "format": "bat {capacity}%",
    "format-charging": "bat {capacity}%+",
    "format-plugged": "bat {capacity}%+"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %B %d, %Y}"
  }
}
