# Optional aliases and functions that were removed from the managed shell config.
# Copy what you need into ~/.zsh_extras and it will be loaded automatically.
#
# cp ~/projects/dotfiles/zsh/.zsh_extras.example ~/.zsh_extras

# ─── ~/apps PATH entries (uncomment if installed locally, not via pkg mgr) ───

# path+=("$HOME/apps/ghostty/bin")

# ─── Git worktree cd ─────────────────────────────────────────────────────────

alias cdwt='f() { cd "$(git worktree list | grep $1 | awk "{print \$1}")"; }; f'

# ─── gcloud SSH ──────────────────────────────────────────────────────────────

function gssh() {
  local ip=$(gcloud compute instances describe "$1" --format='get(networkInterfaces[0].networkIP)' "${@:2}")
  echo $ip
  TERM=xterm-256color ssh "$ip"
}

