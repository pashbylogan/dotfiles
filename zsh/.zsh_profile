# primeagen tmux-sessionizer
bindkey -s ^f "tmux-sessionizer\n"

alias de='deactivate'
alias uf='uvx ruff format '

# Attaches tmux to the last session; creates a new session if none exists.
alias t='tmux attach || tmux new-session'

# Attaches tmux to a session (example: ta portal)
alias ta='tmux attach -t'

# Creates a new session
alias tn='tmux new-session'

# Lists all ongoing sessions
alias tl='tmux list-sessions'

# use specific terminal bc alacritty breaks shit
alias ssh='TERM=xterm-256color ssh'

# vim
alias vim='nvim'
alias vimrc='nvim $HOME/.config/nvim/'

# git
alias gs='git status'
alias gap='git add -p'

alias wta='f() { (cd "$(git rev-parse --show-toplevel)/.." && git worktree add "$@") && "$(git rev-parse --show-toplevel)/../$@"; }; f'
alias wtr='git worktree remove'
alias wtl='git worktree list'
alias wtp='git worktree prune'

# other
alias sz='source ~/.zshrc'

function ve() {
    local local_activate=".venv/bin/activate"
    local base_activate="${DOTFILES_APPS_ROOT:-$HOME/apps}/uv/central_venv_repo/base/.venv/bin/activate"

    if [[ -f "$local_activate" ]]; then
        source "$local_activate"
    elif [[ -f "$base_activate" ]]; then
        source "$base_activate"
    fi
}

#      ___         ___                       ___     
#     /  /\       /  /\          ___        /__/\    
#    /  /::\     /  /::\        /  /\       \  \:\   
#   /  /:/\:\   /  /:/\:\      /  /:/        \__\:\  
#  /  /:/~/:/  /  /:/~/::\    /  /:/     ___ /  /::\ 
# /__/:/ /:/  /__/:/ /:/\:\  /  /::\    /__/\  /:/\:\
# \  \:\/:/   \  \:\/:/__\/ /__/:/\:\   \  \:\/:/__\/
#  \  \::/     \  \::/      \__\/  \:\   \  \::/     
#   \  \:\      \  \:\           \  \:\   \  \:\     
#    \  \:\      \  \:\           \__\/    \  \:\    
#     \__\/       \__\/                     \__\/
export DOTFILES_APPS_ROOT="${DOTFILES_APPS_ROOT:-$HOME/apps}"
export DOTFILES_LOCAL_BIN="${DOTFILES_LOCAL_BIN:-$HOME/.local/bin}"
export DOTFILES_LOCAL_SCRIPTS="${DOTFILES_LOCAL_SCRIPTS:-$HOME/.local/scripts}"
export GOPATH="${GOPATH:-$DOTFILES_APPS_ROOT/go}"
export GOBIN="${GOBIN:-$GOPATH/bin}"
export GOMODCACHE="${GOMODCACHE:-$GOPATH/pkg/mod}"
export GOCACHE="${GOCACHE:-$GOPATH/cache/build}"
export GOENV="${GOENV:-$GOPATH/config/env}"

for extra_path in \
  "$DOTFILES_LOCAL_BIN" \
  "/usr/local/go/bin" \
  "$DOTFILES_APPS_ROOT/bin" \
  "$GOBIN" \
  "$DOTFILES_APPS_ROOT/zig" \
  "$DOTFILES_APPS_ROOT/hugo" \
  "$DOTFILES_APPS_ROOT/heroku/bin" \
  "$DOTFILES_APPS_ROOT/uv" \
  "$DOTFILES_APPS_ROOT/uv/bin" \
  "$DOTFILES_APPS_ROOT/uv/python/bin" \
  "$DOTFILES_LOCAL_SCRIPTS" \
  "$HOME/.opencode/bin"
do
  [[ -d "$extra_path" ]] && path+=("$extra_path")
done
